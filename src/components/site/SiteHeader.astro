---
import logoUrl from "../../../logo.svg?url"

import { LanguageSwitcher } from "./LanguageSwitcher"

interface Props {
  locale: "en" | "tr"
  alternatePath: string
}

const { locale, alternatePath } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "") || "/"

const items = locale === "en"
  ? [
      { href: "/", label: "Home" },
      { href: "/consultancy/", label: "Consultancy" },
      { href: "/cv/", label: "CV" },
      { href: "/blog/", label: "Blog" },
    ]
  : [
      { href: "/tr/", label: "Ana Sayfa" },
      { href: "/tr/danismanlik/", label: "Danışmanlık" },
      { href: "/tr/ozgecmis/", label: "Özgeçmiş" },
      { href: "/tr/blog/", label: "Blog" },
    ]

const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, "") || "/"
  return target === "/" || target === "/tr"
    ? path === target
    : path === target || path.startsWith(`${target}/`)
}

const navItems = items.map((item) => ({ ...item, current: isCurrent(item.href) }))
const homeHref = locale === "en" ? "/" : "/tr/"
const navigationLabel = locale === "en" ? "Primary navigation" : "Ana navigasyon"
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href={homeHref} class="brand-link" aria-label="Erdoğan Bulut">
      <img src={logoUrl} width="145" height="56" alt="Erdoğan Bulut" />
    </a>

    <div class="nav-row">
      <nav class="site-nav" aria-label={navigationLabel}>
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            class:list={["nav-link", { current: item.current }]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <LanguageSwitcher
          client:load
          locale={locale}
          currentHref={Astro.url.pathname}
          alternateHref={alternatePath}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: static;
    border-bottom: 0;
    background: transparent;
  }

  .site-header::before,
  .site-header::after { display: none; }

  .header-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.28rem;
    min-height: 3.85rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    border-radius: 0.25rem;
    opacity: 0.97;
    transition: opacity 160ms ease, filter 160ms ease;
  }
  .brand-link:hover { opacity: 1; filter: brightness(1.08); }
  .brand-link:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
  .brand-link img {
    width: 5.6rem;
    height: auto;
    display: block;
    opacity: 0.99;
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 0.40rem;
    margin-left: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.40rem;
  }
  .nav-link {
    position: relative;
    border-radius: 0.35rem;
    padding: 0.50rem 0.80rem 0.52rem;
    color: oklch(0.62 0 0);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease;
  }
  .nav-link:hover {
    background: oklch(1 0 0 / 0.045);
    color: oklch(0.94 0 0);
  }
  .nav-link.current {
    color: var(--foreground);
    font-weight: 600;
    background: transparent;
  }
  .nav-link.current::after {
    content: "";
    position: absolute;
    left: 0.80rem;
    right: 0.80rem;
    bottom: 0.06rem;
    height: 1.25px;
    background: var(--primary);
    opacity: 1;
    border-radius: 1px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0;
    margin-left: 0;
    border-left: 0;
  }

  @media (max-width: 47.99rem) {
    .header-inner {
      flex-direction: column;
      align-items: stretch;
      min-height: unset;
      gap: 0;
      padding-block: 0.70rem 0;
    }
    .brand-link {
      align-self: flex-start;
    }
    .brand-link img { width: 5.15rem; }
    .nav-row {
      width: 100%;
      margin-left: 0;
      margin-top: 0.75rem;
      padding-block: 0.30rem 0.45rem;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      overflow-x: visible;
      overflow-y: visible;
    }
    .site-nav {
      display: flex;
      align-items: center;
      gap: 0.10rem;
      flex: 0 1 auto;
      min-width: 0;
    }
    .header-actions {
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
      flex: 0 0 auto;
    }
    .nav-link {
      flex: 0 0 auto;
      text-align: center;
      white-space: nowrap;
      padding: 0.60rem 0.45rem 0.62rem;
      font-size: 0.665rem;
      letter-spacing: 0.09em;
      justify-content: center;
    }
    .nav-link:first-child {
      padding-left: 0;
    }
    .nav-link.current::after {
      left: 0.45rem;
      right: 0.45rem;
    }
    .nav-link:first-child.current::after {
      left: 0;
    }
  }

  @media (max-width: 25rem) {
    .site-nav {
      justify-content: space-between;
      min-width: 15rem;
      gap: 0;
    }
    .nav-link,
    .nav-link:first-child {
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }
    .nav-link.current::after,
    .nav-link:first-child.current::after {
      left: 0.25rem;
      right: 0.25rem;
    }
  }
</style>
