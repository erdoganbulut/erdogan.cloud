---
import { Image } from "astro:assets"
import { RssIcon } from "lucide-react"

import { buttonVariants } from "@/components/ui/button"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatBlogDate, getBlogPosts, getBlogSlug, type BlogLocale } from "@/lib/blog"

interface Props {
  locale: BlogLocale
  alternatePath: string
}

const { locale, alternatePath } = Astro.props
const posts = await getBlogPosts(locale)
const basePath = locale === "en" ? "/blog" : "/tr/blog"
const rssPath = locale === "en" ? "/rss.xml" : "/tr/rss.xml"
const description = locale === "en" ? "Blog posts." : "Blog yazıları."
---

<BaseLayout title="Blog" description={description} locale={locale} alternatePath={alternatePath}>
  <section class="site-container blog-shell">
    <header class="blog-header">
      <div class="blog-heading-row">
        <h1 class="page-title">Blog</h1>
        <a
          href={rssPath}
          class={buttonVariants({ variant: "ghost", size: "sm" })}
          aria-label={locale === "en" ? "Subscribe with RSS" : "RSS ile takip et"}
        >
          <RssIcon data-icon="inline-start" aria-hidden="true" />
          RSS
        </a>
      </div>
    </header>

    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => {
          const slug = getBlogSlug(post)
          const href = `${basePath}/${slug}/`

          return (
            <article class="post-card">
              <a href={href} class="post-cover" tabindex="-1" aria-hidden="true">
                <Image src={post.data.cover} alt="" />
              </a>
              <div class="post-copy">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatBlogDate(post.data.pubDate, locale)}
                </time>
                <h2><a href={href}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
              </div>
            </article>
          )
        })}
      </div>
    ) : (
      <p class="empty-state">{locale === "en" ? "No posts yet." : "Henüz yazı yok."}</p>
    )}
  </section>
</BaseLayout>

<style>
  .blog-shell {
    padding-block: 4rem 6.25rem;
  }

  .blog-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    padding-top: 1.86rem;
  }

  .blog-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .post-grid {
    counter-reset: post;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem clamp(1.5rem, 4vw, 2.5rem);
  }

  .post-card {
    counter-increment: post;
  }

  .post-card:first-child {
    grid-column: 1 / -1;
  }

  .post-card:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }

  .post-cover {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .post-cover :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1.9 / 1;
    object-fit: cover;
    transition: scale 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .post-card:first-child .post-cover :global(img) {
    aspect-ratio: 2.35 / 1;
  }

  .post-card:hover .post-cover :global(img) {
    scale: 1.015;
  }

  .post-card:focus-within .post-cover :global(img) {
    scale: 1.015;
  }

  .post-copy {
    max-width: 43rem;
    padding-top: 1.15rem;
  }

  .post-copy::before {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    content: counter(post, decimal-leading-zero);
  }

  time {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  h2 {
    margin-top: 0.65rem;
    color: var(--foreground);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .post-card:first-child h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.035em;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  h2 a:hover,
  .post-card:focus-within h2 a {
    color: var(--primary);
  }

  h2 a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  .post-copy p {
    margin-top: 0.65rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .empty-state {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .post-card:first-child {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.85fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 4rem);
    }

    .post-card:first-child .post-copy {
      padding: 0 0 0.5rem;
    }

    .post-card:first-child .post-copy::before {
      color: var(--primary);
    }

    .post-card:first-child .post-cover :global(img) {
      aspect-ratio: 1.8 / 1;
    }
  }

  @media (max-width: 47.99rem) {
    .blog-shell {
      padding-block: 2.1rem 3.75rem;
    }
    .blog-header { padding-top: 0.85rem; }

    .blog-heading-row {
      align-items: center;
    }

    .post-grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .post-card:first-child {
      display: block;
      grid-column: auto;
    }

    .post-card:first-child .post-cover :global(img),
    .post-cover :global(img) {
      aspect-ratio: 1.65 / 1;
    }
  }
</style>
