---
import SiteFooter from "@/components/site/SiteFooter.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import "@/styles/globals.css"

interface Props {
  title: string
  description: string
  locale: "en" | "tr"
  alternatePath: string
  hasAlternateLocale?: boolean
  type?: "website" | "article"
  image?: { src: string }
}

const {
  title,
  description,
  locale,
  alternatePath,
  hasAlternateLocale = true,
  type = "website",
  image,
} = Astro.props

const pageTitle = title === "Erdoğan Bulut" ? title : `${title} | Erdoğan Bulut`
const canonical = new URL(Astro.url.pathname, Astro.site)
const alternate = new URL(alternatePath, Astro.site)
const oppositeLocale = locale === "en" ? "tr" : "en"
const ogImageUrl = image ? new URL(image.src, Astro.site).toString() : new URL("/og-image.png", Astro.site).toString()
const graph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": "https://erdogan.cloud/#person",
    name: "Erdoğan Bulut",
    url: "https://erdogan.cloud/",
    jobTitle: "AI & Frontend Architect",
    image: "https://erdogan.cloud/og-image.png",
    sameAs: ["https://github.com/erdoganbulut", "https://www.linkedin.com/in/erdoganbulut/"],
  },
  {
    "@type": "WebSite",
    "@id": "https://erdogan.cloud/#website",
    url: "https://erdogan.cloud/",
    name: "Erdoğan Bulut",
    inLanguage: locale === "en" ? "en-US" : "tr-TR",
    author: { "@id": "https://erdogan.cloud/#person" },
  },
]
if (type === "article") {
  graph.push({
    "@type": "BlogPosting",
    headline: title,
    description,
    image: ogImageUrl,
    url: canonical.toString(),
    author: { "@id": "https://erdogan.cloud/#person" },
    inLanguage: locale === "en" ? "en-US" : "tr-TR",
    isPartOf: { "@id": "https://erdogan.cloud/#website" },
  })
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph }
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {hasAlternateLocale && (
      <>
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={oppositeLocale} href={alternate} />
        <link rel="alternate" hreflang="x-default" href={locale === "en" ? canonical : alternate} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Erdoğan Bulut" href={locale === "en" ? "/rss.xml" : "/tr/rss.xml"} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Erdoğan Bulut" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "tr_TR"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {locale === "en" ? "Skip to content" : "İçeriğe geç"}
    </a>
    <SiteHeader locale={locale} alternatePath={alternatePath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
