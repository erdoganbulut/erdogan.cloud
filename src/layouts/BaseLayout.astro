---
import SiteFooter from "@/components/site/SiteFooter.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import "@/styles/globals.css"

interface Props {
  title: string
  description: string
  locale: "en" | "tr"
  alternatePath: string
  hasAlternateLocale?: boolean
  type?: "website" | "article"
  image?: { src: string }
}

const {
  title,
  description,
  locale,
  alternatePath,
  hasAlternateLocale = true,
  type = "website",
  image,
} = Astro.props

const pageTitle = title === "Erdoğan Bulut" ? title : `${title} | Erdoğan Bulut`
const canonical = new URL(Astro.url.pathname, Astro.site)
const alternate = new URL(alternatePath, Astro.site)
const oppositeLocale = locale === "en" ? "tr" : "en"
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {hasAlternateLocale && (
      <>
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={oppositeLocale} href={alternate} />
        <link rel="alternate" hreflang="x-default" href={locale === "en" ? canonical : alternate} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Erdoğan Bulut" href={locale === "en" ? "/rss.xml" : "/tr/rss.xml"} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Erdoğan Bulut" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "tr_TR"} />
    {image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {locale === "en" ? "Skip to content" : "İçeriğe geç"}
    </a>
    <SiteHeader locale={locale} alternatePath={alternatePath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
